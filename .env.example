# Copy to .env.local and fill in. Names only — never commit real values.

# --- Database: Postgres (Neon works well; any Postgres 15+ does) --- server only
DATABASE_URL=             # pooled connection — used by the app
DATABASE_URL_UNPOOLED=    # direct connection — used by drizzle-kit, db:migrate, db:seed and the scripts

# --- Realtime: Ably --- server only. Browsers get role-scoped tokens from /api/realtime/token
ABLY_API_KEY=

# --- Secrets --- server only
ADMIN_PASSCODE=           # passcode for the MC page (/admin)
ADMIN_SESSION_SECRET=     # signs the admin session cookie — openssl rand -hex 32
DEVICE_SALT=              # HMAC salt for device ids — openssl rand -hex 32 (changing it lets every phone vote again)
STAGE_KEY=                # key in the stage URL: /stage?k=<STAGE_KEY> — openssl rand -hex 12

# --- Public (inlined into the client bundle at build time) ---
NEXT_PUBLIC_VOTE_URL=           # address the stage QR code points to, e.g. https://vote.example.com (include the base path if you set one)
NEXT_PUBLIC_VOTE_URL_FALLBACK=  # optional second address the MC can switch the stage QR to
NEXT_PUBLIC_BASE_PATH=          # optional sub-path the app is served under, e.g. /vote (leave empty for the root)

# --- Demo deployment (optional) ---
DEMO_MODE=                # 1 = "sample data" tags, lobby greetings off for good, daily reset cron enabled
CRON_SECRET=              # the reset cron (GET /api/cron/reset-demo) requires "Authorization: Bearer <CRON_SECRET>"; Vercel sends it for you

# --- Tests and scripts (never needed in production) ---
TEST_DB_HOST=             # first label of your TEST database's hostname (e.g. ep-cool-name-123456). Tests and
                          # DB-writing scripts refuse to run against any other host
CHROME_PATH=              # e2e scripts: Chrome/Chromium binary (default: macOS Google Chrome)
E2E_OUT=                  # e2e scripts: where screenshots go (default .e2e-out/<script>)
E2E_SCREEN_OFF_MS=        # e2e:phone: how long the simulated screen-off lasts (default 60000)
VERCEL_AUTOMATION_BYPASS_SECRET=   # load/latency/smoke scripts: Vercel Protection Bypass for a protected preview
