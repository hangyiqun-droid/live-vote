# 154 EVENT Live Vote — env names only (SPEC 8.1). Real values: Vercel env + ~/.config/live-vote.env (chmod 600).
# Preview = Neon branch "dev" + Ably app live-vote-dev · Production = Neon branch "main" + Ably app live-vote

# Neon Postgres (server only)
DATABASE_URL=            # pooled — used by the app
DATABASE_URL_UNPOOLED=   # direct — used by drizzle-kit / scripts/migrate.ts

# Ably (server only — clients get role-scoped tokens from /api/realtime/token)
ABLY_API_KEY=

# Secrets (server only)
ADMIN_PASSCODE=          # MC page passcode (M3)
ADMIN_SESSION_SECRET=    # signs the admin session cookie (M3) — openssl rand -hex 32
DEVICE_SALT=             # HMAC salt for device ids — openssl rand -hex 32 (changing it = every phone can vote again)
STAGE_KEY=               # stage URL key /stage?k=… — openssl rand -hex 12

# Public (inlined into the client bundle)
NEXT_PUBLIC_VOTE_URL=           # https://vote.example.com (QR target)
NEXT_PUBLIC_VOTE_URL_FALLBACK=  # https://<prod alias> (backup QR, M3)
